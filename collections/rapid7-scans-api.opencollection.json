          "http": {
            "method": "GET",
            "url": "https://[region].api.insight.rapid7.com/ias/v1/scans/:scan-id/platform-events",
            "params": [
              {
                "name": "scan-id",
                "value": "",
                "type": "path"
              }
            ]
