        {
          "info": {
            "name": "Agents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://[region].api.insight.rapid7.com/ias/v1/api/3/agents",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The index of the page (zero-based) to retrieve."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The number of records per page to retrieve."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "The criteria to sort the records by, in the format: `property[,ASC|DESC]`. The default sort order is ascending. Multiple sort criteria can be specified using multiple sort query parameters."
              }
            ]
          },
          "docs": "Returns the details for all agents."
        },
        {
          "info": {
            "name": "Asset Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://[region].api.insight.rapid7.com/ias/v1/api/3/asset_groups",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "The type of asset group."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "A search pattern for the name of the asset group. Searches are case-insensitive contains."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The index of the page (zero-based) to retrieve."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The number of records per page to retrieve."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
